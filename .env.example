# OpenAI API Key (required for LLM-as-a-judge and simulation)
OPENAI_API_KEY=your_openai_api_key_here

# Confident AI API Key (optional, ONLY set if using Confident AI cloud features)
# Leave this commented out to run evaluations locally without cloud integration
# CONFIDENT_API_KEY=your_confident_api_key_here

# Disable DeepEval telemetry (recommended if not using Confident AI)
DEEPEVAL_TELEMETRY_OPT_OUT=YES

# Your Agent API Configuration (customize based on your agent)
AGENT_API_URL=http://localhost:8000/chat
AGENT_API_KEY=your_agent_api_key_here

# Judge LLM Configuration (optional, defaults to gpt-4o)
JUDGE_MODEL=gpt-4o
JUDGE_TEMPERATURE=0.0

# Simulation Configuration
MAX_CONCURRENT_SIMULATIONS=10
DEFAULT_MAX_TURNS=15
